-- 3. Create Recommendations (Child of EmployeeRoles)
CREATE TABLE Recommendations (
    RecommendationID INT PRIMARY KEY AUTO_INCREMENT,
    RoleID INT NOT NULL,
    Justification TEXT,
    Approved BOOLEAN,
    Notes TEXT,
    FOREIGN KEY (RoleID) REFERENCES EmployeeRoles(RoleID)
);
